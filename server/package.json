{
  "name": "proed-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "setup": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/setup.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@proed/shared": "1.0.0",
    "fastify": "^5.12.8",
    "otplib": "^13.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/qrcode": "^1.5.6"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.2.0"
  }
}
