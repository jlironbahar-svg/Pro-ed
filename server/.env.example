# ProEd server settings. Copy to server/.env and fill in.
# "npm run setup -w proed-server" generates the secrets below and writes them to server/.env.
# Never commit server/.env.

# Network
PORT=8787
HOST=0.0.0.0
# Public HTTPS address of the server (used for APK download links).
PUBLIC_URL=https://proed.example.com
# Behind Fly.io / Render / a reverse proxy: trust X-Forwarded-* and redirect HTTP to HTTPS.
TRUST_PROXY=true
FORCE_HTTPS=true

# Storage (SQLite database and uploaded APKs)
DATA_DIR=./data
# Built PWA to serve (defaults to ../proed-app/dist)
# PWA_DIR=../proed-app/dist
# Built web version of ProEd Admin, served at /console/ (defaults to ../proed-admin/dist-web)
# ADMIN_WEB_DIR=../proed-admin/dist-web

# Origins allowed to call /api and /admin from the Android apps (Capacitor uses https://localhost).
CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost

# Secrets (generated by the setup script)
ADMIN_JWT_SECRET=
# ES256 key pair for access tokens, PEM encoded in base64 (one line each).
ACCESS_PRIVATE_KEY=
ACCESS_PUBLIC_KEY=

# How long the app keeps working offline with its last access token (hours).
ACCESS_GRACE_HOURS=72
# Admin session length (hours).
ADMIN_SESSION_HOURS=12

# Extra Pronote hosts for the relay, comma separated (for schools not on *.index-education.net).
RELAY_EXTRA_HOSTS=

# Time zone for daily statistics.
TIME_ZONE=Europe/Paris

LOG_LEVEL=info
